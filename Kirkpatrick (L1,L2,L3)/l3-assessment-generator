## Step 4 — Code pattern

```python
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter

wb = Workbook()

# Build competency data structure first — derived from training materials
competencies = [
  {
    "no": 1,
    "name": "...",
    "items": [
      {
        "no_item": 1,
        "pertanyaan": "Selama 3 bulan ke belakang...",
        "indikator": "Peserta mampu...",
        "perilaku": "...",
        "skor1": "Tidak ada perubahan — ...",
        "skor2": "Ada ..., namun ...",
        "skor3": "Peserta mulai ..., namun ...",
        "skor4": "Peserta secara konsisten ...",
        "skor5": "Peserta menjadi [role model] — ...",
      },
    ]
  },
]

# Helper functions: fill(), thin_border(), sc() for single cell, mc() for merged cell,
# merge_rows() for vertical merge across rows in one column

# Build Sheet 1 (blank form)
ws1 = wb.active
ws1.title = "L3 Assessment"
build_assessment_sheet(ws1, sample_scores=None)

# Build Sheet 2 (interpretation guide)
ws2 = wb.create_sheet("Panduan Membaca Hasil")
build_panduan_sheet(ws2)

# Build Sheet 3 (filled example)
ws3 = wb.create_sheet("Contoh Pengisian")
sample = {
    "identity": ["[Name]", "[Supervisor Name]", "[Title]", "[Division]", "[Date]"],
    "scores": {1: 4, 2: 5, 3: 3, ...},   # no_item → integer score
}
build_assessment_sheet(ws3, sample_scores=sample)

wb.save("/mnt/user-data/outputs/L3_Assessment_{ProgramName}.xlsx")
```

